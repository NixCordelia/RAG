# 复制本文件为 .env 后再改。程序只读 .env，不读本文件。
# PowerShell:  Copy-Item .env.example .env
# .env 已加入 .gitignore。

# auto | openai | hash | m3e
# 本地中文向量：
EMBED_BACKEND=m3e
EMBED_MODEL=moka-ai/m3e-small
CHUNK_STRATEGY=section
# 检索：先取 RETRIEVE_K 个块，再按文档收束到 RETRIEVE_DOC_K；SCORE_REL 为相对头名的保留门槛
# RETRIEVE_K=8
# RETRIEVE_DOC_K=5
# SCORE_REL=0.58
# GROUND_MIN=0.4

# 问答生成（Agent）。不填则走抽取式。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini

# 评测裁判（Ragas Faithfulness）。不填则复用上面的 Chat。
# 可与生成不是同一家网关，例如生成用 DeepSeek、裁判用更便宜的模型。
# EVAL_API_KEY=
# EVAL_BASE_URL=https://api.openai.com/v1
# EVAL_CHAT_MODEL=gpt-4o-mini

# 远程 Embedding 时取消注释：
# EMBED_BACKEND=openai
# EMBED_MODEL=text-embedding-3-small
